# Copy to .env and adjust for your environment.

# Default is a local SQLite file — zero setup required.
# For production, point this at PostgreSQL + PostGIS, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/renewable_platform
DATABASE_URL=sqlite:///./renewable_platform.db

JWT_SECRET_KEY=change-this-to-a-long-random-string

# Optional real data sources to wire into app/services/environmental_engine.py
NASA_POWER_API_KEY=
OPENWEATHER_API_KEY=
COPERNICUS_SENTINEL_HUB_CLIENT_ID=
COPERNICUS_SENTINEL_HUB_CLIENT_SECRET=
