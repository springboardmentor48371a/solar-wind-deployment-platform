# Copy this file to .env and fill in real values

# PostgreSQL connection (use PostGIS-enabled Postgres in production)
DATABASE_URL=postgresql://swdip_user:swdip_pass@localhost:5432/swdip_db

# For quick local testing without Postgres installed, you can instead use:
# DATABASE_URL=sqlite:///./swdip_dev.db

# MongoDB (secondary database — raw external-API payload archive)
# If Mongo is reachable from anywhere but localhost, run it with auth
# enabled and include credentials here, e.g.:
#   MONGODB_URL=mongodb://swdip_mongo:swdip_mongo_pass@localhost:27017/?authSource=admin
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=swdip_raw

# Redis (cache — external API responses, keyed by rounded coordinates).
# The app runs fine without this reachable; app/cache.py falls back to an
# in-process cache automatically. Only worth setting if you're running
# Redis locally outside docker-compose.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Staff PIN — required, on top of a user's own password, to register as or
# log in as GIS Analyst / Project Manager / Administrator. Hand this out
# only to actual staff. Change it from the default before any real use.
STAFF_PIN=1248

# External data APIs
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
ELEVATION_API_BASE_URL=https://api.open-elevation.com/api/v1/lookup
OVERPASS_API_BASE_URL=https://overpass-api.de/api/interpreter

# Security
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to "production" before a public demo/deploy — disables /docs, /redoc, /openapi.json
ENVIRONMENT=development
