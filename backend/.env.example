# App
PROJECT_NAME="Solar & Wind Deployment Intelligence Platform"
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# Security
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OAuth2 (Google example — fill in when you register an OAuth app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL + PostGIS (primary DB)
POSTGRES_USER=swdi_user
POSTGRES_PASSWORD=swdi_password
POSTGRES_DB=swdi_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MongoDB (secondary DB)
MONGO_USER=swdi_mongo
MONGO_PASSWORD=swdi_mongo_password
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=swdi_mongo_db

# External APIs (Satellite & Environmental)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
OPENWEATHER_API_KEY=
COPERNICUS_SENTINEL_USER=
COPERNICUS_SENTINEL_PASSWORD=
