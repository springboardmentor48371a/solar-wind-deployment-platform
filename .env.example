# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------------------------------
# Database
# When running with Docker (default), keep this as is.
# For a shared cloud database, replace with your RDS/Supabase URL.
# -------------------------------------------------------------------
DATABASE_URL=postgresql://solarwind:solarwind123@db:5432/solarwind_db

# -------------------------------------------------------------------
# JWT Secret Key
# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never share this or commit it to Git.
# -------------------------------------------------------------------
SECRET_KEY=replace-this-with-your-generated-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------------------
# Google OAuth (optional)
# Email/password login works without these.
# To enable Google login, create OAuth credentials at:
#   https://console.cloud.google.com/
# Add http://localhost:8000/auth/google/callback as redirect URI.
# -------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
