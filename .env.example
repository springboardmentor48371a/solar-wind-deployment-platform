# Database Configuration (PostgreSQL with PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/solar_wind_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solar_wind_db
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=solar_wind_analytics

# Security & JWT
JWT_SECRET=super_secret_jwt_key_for_solar_wind_deployment_platform_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External API Keys (Optional - demo generator activates automatically if unset)
NASA_POWER_API_KEY=
OPENWEATHER_API_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Economic Modeling
ELECTRICITY_PRICE_PER_KWH=0.075
CORS_ORIGINS=["*"]
DEMO_MODE=true
