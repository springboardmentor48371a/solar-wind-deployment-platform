# Used by docker-compose.yml — copy to .env in the project root before
# running `docker compose up`.

SECRET_KEY=change-this-to-a-long-random-string
ENVIRONMENT=development

# Required, on top of a password, to register/log in as GIS Analyst,
# Project Manager, or Administrator. Change from the default before real use.
STAFF_PIN=1248

# Optional — override the default local MongoDB dev credentials that
# docker-compose.yml sets up.
MONGO_USER=swdip_mongo
MONGO_PASSWORD=swdip_mongo_pass

# ---------------------------------------------------------------------
# Everything below is OPTIONAL. The platform runs completely fine with
# none of it set — each connector reports "not_configured" on the
# Admin/GIS dashboard instead of attempting a call with no credentials.
# Add any of these to docker-compose.yml's `backend.environment` block
# (not here — this file only feeds docker-compose's own variable
# substitution, not the backend container directly) once you have real
# values. Steps to get each:
#
# SENTINEL_HUB_CLIENT_ID / SENTINEL_HUB_CLIENT_SECRET
#   -> Free account at https://www.sentinel-hub.com/, then
#      Dashboard -> User Settings -> OAuth clients -> Create.
#      Enables real satellite imagery (land cover, NDVI, cloud cover).
#
# OPENWEATHER_API_KEY
#   -> Free account at https://openweathermap.org/api, "API keys" tab.
#      Enables live current-conditions cross-check (separate from the
#      NASA POWER historical data that suitability scoring uses).
#
# DATA_LAKE_BUCKET (+ DATA_LAKE_ACCESS_KEY_ID / DATA_LAKE_SECRET_ACCESS_KEY)
#   -> Any S3 bucket (AWS) or S3-compatible bucket (Cloudflare R2,
#      Backblaze B2, self-hosted MinIO). Enables raw-payload archival
#      alongside the MongoDB copy every fetch already writes to.
# ---------------------------------------------------------------------
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=
# OPENWEATHER_API_KEY=
# DATA_LAKE_BUCKET=
# DATA_LAKE_ACCESS_KEY_ID=
# DATA_LAKE_SECRET_ACCESS_KEY=
# DATA_LAKE_S3_ENDPOINT_URL=
# SENTRY_DSN=
