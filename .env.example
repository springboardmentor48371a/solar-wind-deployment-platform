# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------------------------------
# Frontend API URL
# Local dev: leave blank — Vite proxy handles /api → backend:8000
# Production (Render): set to your deployed backend URL
# e.g. VITE_API_URL=https://solar-wind-backend.onrender.com
# -------------------------------------------------------------------
VITE_API_URL=

# -------------------------------------------------------------------
# ML Service URL
# Local dev: leave blank — defaults to http://ml-service:8001 (Docker internal)
# Production (Render): set to your deployed ml-service URL
# e.g. ML_SERVICE_URL=https://solar-wind-ml.onrender.com
# -------------------------------------------------------------------
ML_SERVICE_URL=

# -------------------------------------------------------------------
# Database
# When running with Docker (default), keep this as is.
# For a shared cloud database, replace with your RDS/Supabase URL.
# -------------------------------------------------------------------
DATABASE_URL=postgresql://solarwind:solarwind123@db:5432/solarwind_db

# -------------------------------------------------------------------
# JWT Secret Key
# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never share this or commit it to Git.
# -------------------------------------------------------------------
SECRET_KEY=replace-this-with-your-generated-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------------------
# Google OAuth (optional)
# Email/password login works without these.
# To enable Google login, create OAuth credentials at:
#   https://console.cloud.google.com/
# Add http://localhost:8000/auth/google/callback as redirect URI.
# -------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -------------------------------------------------------------------
# Google Earth Engine (land cover ML pipeline)
# Required for live Sentinel-2/VIIRS feature extraction.
# Without these, land cover falls back to rule-based NDVI+slope scoring.
#
# Setup:
#   1. Go to console.cloud.google.com → IAM & Admin → Service Accounts
#   2. Create a service account, grant it Earth Engine access
#   3. Generate a JSON key and save it somewhere outside this repo
#   4. Register the service account at code.earthengine.google.com
#
# GEE_SERVICE_ACCOUNT  — service account email (e.g. name@project.iam.gserviceaccount.com)
# GEE_KEY_FILE         — path to the JSON key file, accessible inside the container.
#                        Simplest approach: place the key file inside ml-service/ so it's
#                        already mounted via the existing ./ml-service:/app volume, then
#                        set GEE_KEY_FILE=/app/gee-key.json
# GEE_PROJECT          — GCP project ID (defaults to astral-pipe-508512-s9 if not set)
# -------------------------------------------------------------------
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_KEY_FILE=/app/gee-key.json
GEE_PROJECT=astral-pipe-508512-s9
